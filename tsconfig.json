{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2022",
		"allowJs": true,
		"checkJs": false,
		"noImplicitAny": true,
		"moduleResolution": "node",
		"isolatedModules": true,
		"strictNullChecks": true,
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"lib": ["DOM", "ES2022", "DOM.Iterable"]
	},
	"include": ["src/**/*.ts", "scripts/**/*.ts"]
}
